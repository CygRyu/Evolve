+            retireW(wr){
+                this.$buefy.dialog.confirm({
+                    message: loc('sw_retire_confirm',[wr.name]),
+                    confirmText: loc('sw_retire'),
+                    onConfirm: () => retire(wr.id)
+                });
+            }
+        }
+    });
+}
