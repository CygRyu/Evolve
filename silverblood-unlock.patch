 MODDING.md                     | 5 +++--
 mods/example-starter-pack.json | 1 +
 src/actions.js                 | 1 +
 src/mods.js                    | 2 ++
 src/races.js                   | 1 +
 5 files changed, 8 insertions(+), 2 deletions(-)

